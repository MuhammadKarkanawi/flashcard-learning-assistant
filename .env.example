# App
APP_ENV=development
DATABASE_URL=sqlite:///./data/flashcards.db

# Local LLM (OpenAI-compatible endpoint, e.g. Ollama)
# When running the app in Docker, host.docker.internal points back at the host machine.
MODEL_BASE_URL=http://host.docker.internal:11434/v1
MODEL_NAME=gemma3n:e4b
MODEL_API_KEY=not-needed
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=1

# Flashcard generation
MAX_CARDS_PER_CHUNK=3
CHUNK_MAX_CHARS=1200
DUPLICATE_SIMILARITY_THRESHOLD=0.85
